rules_version = '2';

// RELATÓRIOS OPERACIONAIS — Juanil Transportes Rodoviários
// Plano gratuito (Spark): regras enxutas, só coleções necessárias.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth.token.email == "operacional@juanil.com.br";
    }

    function isDiretoria() {
      return request.auth.token.email == "diretoria@juanil.com.br";
    }

    match /relatorios/{relatorioId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && !isDiretoria()
                    && request.resource.data.criadoPorUid == request.auth.uid;

      allow update: if request.auth != null && (
                      isAdmin()
                      || (
                        resource.data.criadoPorUid == request.auth.uid
                        && resource.data.status != "concluido"
                      )
                      || isDiretoria()
                    );

      allow delete: if request.auth != null && (
                      isAdmin()
                      || (
                        resource.data.criadoPorUid == request.auth.uid
                        && resource.data.status != "concluido"
                      )
                    );
    }

    match /contadores/{ano} {
      allow read, write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
